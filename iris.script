    // Docker demo setup. Runs once at image build (see Dockerfile).
    // The IRISAPP namespace (Interoperability enabled) is created by merge.cpf.

    ZN "%SYS"
    // Install IPM and enable community packages
    Do $System.OBJ.Load("/tmp/zpm.xml", "ck")
    zpm "enable -map -globally"
    zpm "enable -community"

    // Demo only: keep the default passwords from expiring. Never do this in production.
    Do ##class(Security.Users).UnExpireUserPasswords("*")

    ZN "IRISAPP"

    // Lets VS Code's Testing panel run the unit tests in this namespace
    zpm "install vscode-per-namespace-settings"
    Set ^UnitTestRoot = "/usr/irissys/.vscode/IRISAPP/UnitTestRoot"

    // Install the package. Its install hook creates the outbound SSL config only;
    // the public webhook endpoint is NOT created here: run CreateWebApp() yourself,
    // it shows what it will change and asks first.
    zpm "load /home/irisowner/dev/ -v":1:1
    Halt
